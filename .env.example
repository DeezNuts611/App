# Copy this file to .env and replace every placeholder.
# Use a long, unique random value (at least 32 bytes) for SESSION_SECRET.
NODE_ENV=development
PORT=3000
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# First administrator is created on first start if both values are set.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
